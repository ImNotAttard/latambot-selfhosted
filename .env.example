# ==============================================================================
# Variables de entorno de LatamBOT
# Copiá este archivo a .env y completá los valores:  cp .env.example .env
# El .env real NO se sube a git (está en .gitignore). Lo carga latambot.py
# al arrancar; las variables ya presentes en el entorno (los -e de Docker)
# tienen prioridad sobre el .env.
# ==============================================================================

# OBLIGATORIA: token del bot de Discord (producción).
DISCORD_TOKEN=
# Token del bot de debug (solo si corrés con LATAM_DEBUG).
DISCORD_TOKEN_DEBUG=

# Dashboard y OAuth2 (obligatorio solo si vas a usar el panel).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_BASE_URL=http://localhost:8080
DASHBOARD_SESSION_SECRET=
DASHBOARD_OWNER_ONLY=false
DASHBOARD_PORT=8080
OWNER_ID=
AUTOJOIN_GUILD_ID=

# IDs y URLs opcionales de tu instalación.
SERVER_NOTIF_ID=
SERVER_SOPORTE_ID=
PUBLIC_BASE_URL=
PANEL_URL=
DOCS_URL=
BOT_INVITE_URL=
KOFI_URL=
PATREON_URL=

# --- IA ---
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Búsqueda / medios ---
SERPAPI_KEY=
THECATAPI_KEY=
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=

# --- Cloudflare R2 (subida de descargas l!dl) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
R2_OBJECT_PREFIX=yt-dlp
R2_CACHE_CONTROL=public, max-age=31536000, immutable
R2_MULTIPART_MB=32

# Webhooks/observabilidad opcionales.
TOPGG_WEBHOOK_SECRET=
DBL_WEBHOOK_SECRET=
SENTRY_DSN=

# Nodo de descargas opcional.
PI_WORKER_URL=
PI_WORKER_TOKEN=
PI_WORKER_TOKEN_FILE=

# Carpeta donde se guarda la base de datos persistente (en Docker: /data).
DATA_DIR=/data
# Límite de tamaño de descargas en MB (default 50).
DL_MAX_SIZE_MB=50
